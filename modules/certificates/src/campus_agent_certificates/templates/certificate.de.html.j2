{#- Built-in certificate template. Groups override it via modules.certificates.template.
    Only data from the approved application reaches this template; the model never writes it. -#}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <title>Engagementbescheinigung {{ number }}</title>
  <style>
    body { font-family: sans-serif; margin: 2.5cm; }
    table { border-collapse: collapse; width: 100%; }
    td, th { border-bottom: 1px solid #ccc; padding: 0.3em; text-align: left; }
  </style>
</head>
<body>
  <p>{{ group.name }}</p>
  <h1>Engagementbescheinigung</h1>
  <p>Nr. {{ number }} &middot; ausgestellt am {{ issued_on }}</p>
  <p>{{ member.name }} war vom {{ period.start }} bis {{ period.end }} ehrenamtlich
     im {{ group.name }} tätig.</p>
  <table>
    <thead><tr><th>Tätigkeit</th><th>Zeitraum</th></tr></thead>
    <tbody>
    {%- for activity in activities %}
      <tr><td>{{ activity.title }}</td><td>{{ activity.start }} – {{ activity.end }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  <p>Für den Vorstand: {{ approver.name }}</p>
</body>
</html>
