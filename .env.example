# Environment variables of campus-agent. Copy to .env for local overrides; never commit .env.
# All values below are fictional placeholders.

# Both services: local, dev or prod (required; local-only switches are refused elsewhere)
CAMPUS_AGENT_ENV=local
CAMPUS_AGENT_CONFIG=examples/musterverein/campus-agent.yaml

# Local development without Teams (refused outside CAMPUS_AGENT_ENV=local)
DEV_FAKE_USER=00000000-0000-4000-8000-000000000001
DEV_FAKE_ROLE=member

# Used in campus-agent.yaml
GROUP_TEAM_LEAD=00000000-0000-4000-8000-0000000000a1
GROUP_BOARD=00000000-0000-4000-8000-0000000000b1
SHAREPOINT_SITE_ID=musterverein.example,00000000-0000-4000-8000-0000000000c1,00000000-0000-4000-8000-0000000000c2
AZURE_OPENAI_DEPLOYMENT=example-deployment

# Bot
AZURE_OPENAI_ENDPOINT=https://example.invalid
MCP_URL=http://localhost:8000/mcp
MCP_AUDIENCE=api://00000000-0000-4000-8000-0000000000d1

# Runtime state (Azurite locally)
TABLE_STORAGE_URL=http://127.0.0.1:10002/devstoreaccount1
